{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "skills",
    "growth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{2,63}$"
      }
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "mp",
        "attack",
        "defense",
        "magic",
        "resistance",
        "speed",
        "luck"
      ],
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "mp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "attack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "defense": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "magic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "resistance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "speed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "luck": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      }
    }
  }
}
