{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "encounter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "regionId",
    "enemies",
    "rewards",
    "boss"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "regionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "creatureId",
          "level"
        ],
        "properties": {
          "creatureId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xp",
        "gold"
      ],
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boss": {
      "type": "boolean"
    }
  }
}
