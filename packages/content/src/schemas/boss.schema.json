{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boss",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "recruitable",
    "hp",
    "phases",
    "rewards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "recruitable": {
      "const": false
    },
    "hp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hpAbovePercent",
          "skills"
        ],
        "properties": {
          "id": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "hpAbovePercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,63}$"
            }
          },
          "fireDamagePercent": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xp",
        "items"
      ],
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          }
        }
      }
    }
  }
}
