{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "creature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "element",
    "recruitable",
    "baseChance",
    "baseStats",
    "evolutions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "element": {
      "enum": [
        "neutral",
        "fire",
        "water",
        "earth",
        "wind",
        "ice",
        "light",
        "shadow"
      ]
    },
    "recruitable": {
      "type": "boolean"
    },
    "baseChance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 85
    },
    "baseStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "mp",
        "attack",
        "defense",
        "magic",
        "resistance",
        "speed",
        "luck"
      ],
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "mp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "attack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "defense": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "magic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "resistance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "speed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "luck": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      }
    },
    "evolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "minLevel",
          "minAffinity"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "minLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "minAffinity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "questFlag": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "requiredItem": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          }
        }
      }
    }
  }
}
