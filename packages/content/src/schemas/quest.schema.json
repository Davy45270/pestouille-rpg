{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "steps",
    "rewards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{2,63}$"
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xp",
        "items"
      ],
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          }
        }
      }
    }
  }
}
